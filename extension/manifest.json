{
  "manifest_version": 3,
  "name": "Velocity",
  "version": "2.0.4",
  "description": "Prompt Co-Pilot: Turn unclear instructions into AI-ready prompts in one click. Save time, unlock results & boost productivity by 30%",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  
  "action": {
    "default_popup": "phase1.html"
  },
  "icons": {
    "16": "icon48-1.png",
    "32": "icon32.png",
    "48": "icon48-1.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [{
    "resources": [
      "mixpanel.min.js",
      "src/velocity-inject.css",
      "assets/logo.png",
      "assets/logo.png",
      "assets/desc.png",
      "assets/cre.png",
      "assets/pro.png",
      "assets/conc.png"
    ],
    "matches": ["<all_urls>"]
  }],

  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://discord.com/channels/*",
        "https://gamma.app/*",
        "https://runway.com/*",
        "https://thinkvelocity.in/*"
      ],
      "js": ["content-script.js"],
      "css": ["src/output.css"],
       "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
    },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "https://www.toteminteractive.in/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://discord.com/channels/*",
    "https://gamma.app/*",
    "https://runway.com/*",
    "https://thinkvelocity.in/*"
  ]
}