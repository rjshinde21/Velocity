{
  "manifest_version": 4,
  "name": "Velocity",
  "version": "1.2",
  "description": "Improve your prompt design with Velocity",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  
  "action": {
    "default_popup": "phase1.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48-1.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["src/output.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://www.toteminteractive.in/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://*/*"
  ]
}
